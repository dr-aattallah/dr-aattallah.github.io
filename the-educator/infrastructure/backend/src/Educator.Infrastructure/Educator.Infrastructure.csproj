    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
    <ProjectReference Include="../Educator.Application/Educator.Application.csproj" />
    <ProjectReference Include="../Educator.Domain/Educator.Domain.csproj" />
  </ItemGroup>
